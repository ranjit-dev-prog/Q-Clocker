# Application
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
APP_NAME=Q Clocker
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/q_clocker
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=q_clocker
DB_SSL=false

# JWT Authentication
JWT_SECRET=q_clocker_super_secure_jwt_secret_key_2026_enterprise_secure
JWT_EXPIRATION=1d
JWT_REFRESH_EXPIRATION=7d

# Throttling / Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Initial Super Admin Seed (Auto-created on first run)
SUPER_ADMIN_EMAIL=superadmin@qclocker.io
SUPER_ADMIN_PASSWORD=SuperAdmin@2026!
