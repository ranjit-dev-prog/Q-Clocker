datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================
// 1. ROLES & GRANULAR PERMISSIONS
// =============================================================

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String?          @db.Text
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  module          String           @db.VarChar(50)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@map("role_permissions")
}

// =============================================================
// 2. DEPARTMENTS, TEAMS & DESIGNATIONS
// =============================================================

model Department {
  id           String        @id @default(uuid()) @db.Uuid
  referenceId  String        @unique @map("reference_id") @db.VarChar(20)
  name         String        @unique @db.VarChar(100)
  code         String        @unique @db.VarChar(20)
  description  String?       @db.Text
  managerId    String?       @map("manager_id") @db.Uuid
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  manager      User?         @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams        Team[]
  designations Designation[]
  users        User[]        @relation("UserDepartment")
  projects     Project[]
  assets       Asset[]
  tasks        Task[]
  tickets      Ticket[]

  @@map("departments")
}

model Team {
  id           String     @id @default(uuid()) @db.Uuid
  referenceId  String     @unique @map("reference_id") @db.VarChar(20)
  name         String     @db.VarChar(100)
  departmentId String     @map("department_id") @db.Uuid
  leadId       String?    @map("lead_id") @db.Uuid
  description  String?    @db.Text
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead         User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  users        User[]     @relation("UserTeam")
  tasks        Task[]
  tickets      Ticket[]   @relation("TicketAssignedTeam")

  @@map("teams")
}

model Designation {
  id           String      @id @default(uuid()) @db.Uuid
  referenceId  String      @unique @map("reference_id") @db.VarChar(20)
  name         String      @db.VarChar(100)
  code         String      @unique @db.VarChar(50)
  departmentId String?     @map("department_id") @db.Uuid
  description  String?     @db.Text
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users        User[]

  @@map("designations")
}

// =============================================================
// 3. USERS, EMPLOYEES & SESSIONS
// =============================================================

model User {
  id                       String              @id @default(uuid()) @db.Uuid
  referenceId              String              @unique @map("reference_id") @db.VarChar(20)
  employeeCode             String?             @unique @map("employee_code") @db.VarChar(50)
  email                    String              @unique @db.VarChar(255)
  personalEmail            String?             @map("personal_email") @db.VarChar(255)
  passwordHash             String              @map("password_hash") @db.VarChar(255)
  firstName                String              @map("first_name") @db.VarChar(100)
  lastName                 String              @map("last_name") @db.VarChar(100)
  phone                    String?             @db.VarChar(30)
  avatarUrl                String?             @map("avatar_url") @db.Text
  roleId                   String              @map("role_id") @db.Uuid
  roleCode                 String              @default("EMPLOYEE") @map("role_code") @db.VarChar(50)
  departmentId             String?             @map("department_id") @db.Uuid
  teamId                   String?             @map("team_id") @db.Uuid
  designationId            String?             @map("designation_id") @db.Uuid
  managerId                String?             @map("manager_id") @db.Uuid
  jobTitle                 String?             @map("job_title") @db.VarChar(100)
  employmentType           String              @default("FULL_TIME") @map("employment_type") @db.VarChar(50)
  joiningDate              DateTime?           @map("joining_date") @db.Date
  workLocation             String              @default("Headquarters") @map("work_location") @db.VarChar(100)
  hasLoginAccount          Boolean             @default(true) @map("has_login_account")
  accountStatus            String              @default("ACTIVE") @map("account_status") @db.VarChar(30)
  invitationToken          String?             @map("invitation_token") @db.VarChar(255)
  invitationTokenExpiresAt DateTime?           @map("invitation_token_expires_at") @db.Timestamptz
  isActive                 Boolean             @default(true) @map("is_active")
  lastLoginAt              DateTime?           @map("last_login_at") @db.Timestamptz
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz
  archivedAt               DateTime?           @map("archived_at") @db.Timestamptz
  archivedById             String?             @map("archived_by_id") @db.Uuid

  role                     Role                @relation(fields: [roleId], references: [id])
  department               Department?         @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  team                     Team?               @relation("UserTeam", fields: [teamId], references: [id], onDelete: SetNull)
  designation              Designation?        @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager                  User?               @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates             User[]              @relation("UserManager")
  managedDepartments       Department[]        @relation("DepartmentManager")
  ledTeams                 Team[]              @relation("TeamLead")
  ledProjects              Project[]           @relation("ProjectLead")
  assignedAssets           Asset[]             @relation("AssetAssignedUser")
  sessions                 UserSession[]
  createdTasks             Task[]              @relation("TaskCreator")
  reviewedTasks            Task[]              @relation("TaskReviewer")
  taskAssignments          TaskAssignment[]    @relation("AssignedEmployee")
  assignedTasksBy          TaskAssignment[]    @relation("AssignedByUser")
  taskComments             TaskComment[]
  taskAttachments          TaskAttachment[]
  requestedTickets         Ticket[]            @relation("TicketRequester")
  assignedTickets          Ticket[]            @relation("TicketTechnician")
  ticketComments           TicketComment[]
  ticketHistory            TicketHistory[]
  workLogs                 WorkLog[]           @relation("WorkLogEmployee")
  verifiedWorkLogs         WorkLog[]           @relation("WorkLogVerifier")
  attendanceEvents         AttendanceEvent[]   @relation("AttendanceEmployee")
  verifiedAttendances      AttendanceEvent[]   @relation("AttendanceVerifier")
  workSessions             WorkSession[]
  taskTimeEntries          TaskTimeEntry[]
  ticketTimeEntries        TicketTimeEntry[]
  timesheets               Timesheet[]         @relation("TimesheetEmployee")
  approvedTimesheets       Timesheet[]         @relation("TimesheetApprover")
  requestedApprovals       Approval[]          @relation("ApprovalRequester")
  assignedApprovals        Approval[]          @relation("ApprovalApprover")
  ownedFollowUps           FollowUp[]          @relation("FollowUpOwner")
  assignedFollowUps        FollowUp[]          @relation("FollowUpAssignedTo")
  reminders                Reminder[]
  notifications            Notification[]
  performanceReviews       PerformanceReview[] @relation("ReviewEmployee")
  conductedReviews         PerformanceReview[] @relation("ReviewReviewer")
  auditLogs                AuditLog[]
  processedPayrollBatches  PayrollBatch[]      @relation("BatchProcessor")
  payslips                 Payslip[]
  taxDeclarations          TaxDeclaration[]    @relation("TaxDeclarationEmployee")
  verifiedTaxDeclarations  TaxDeclaration[]    @relation("TaxDeclarationVerifier")
  lifecycleEvents          LifecycleEvent[]
  updatedAppSettings       AppSetting[]

  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  referenceId      String   @unique @map("reference_id") @db.VarChar(20)
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?  @map("user_agent") @db.Text
  ipAddress        String?  @map("ip_address") @db.VarChar(50)
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// =============================================================
// 4. PROJECTS & ASSETS
// =============================================================

model Project {
  id           String      @id @default(uuid()) @db.Uuid
  referenceId  String      @unique @map("reference_id") @db.VarChar(20)
  name         String      @db.VarChar(150)
  code         String      @unique @db.VarChar(50)
  description  String?     @db.Text
  departmentId String?     @map("department_id") @db.Uuid
  leadId       String?     @map("lead_id") @db.Uuid
  status       String      @default("ACTIVE") @db.VarChar(30)
  startDate    DateTime?   @map("start_date") @db.Date
  endDate      DateTime?   @map("end_date") @db.Date
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lead         User?       @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@map("projects")
}

model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  referenceId  String      @unique @map("reference_id") @db.VarChar(20)
  name         String      @db.VarChar(150)
  assetTag     String      @unique @map("asset_tag") @db.VarChar(50)
  category     String      @db.VarChar(50)
  status       String      @default("AVAILABLE") @db.VarChar(30)
  assignedToId String?     @map("assigned_to_id") @db.Uuid
  departmentId String?     @map("department_id") @db.Uuid
  details      String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  assignedTo   User?       @relation("AssetAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@map("assets")
}

// =============================================================
// 5. TASKS & WORK MANAGEMENT
// =============================================================

model Task {
  id                   String           @id @default(uuid()) @db.Uuid
  referenceId          String           @unique @map("reference_id") @db.VarChar(20)
  taskNumber           String           @unique @map("task_number") @db.VarChar(50)
  title                String           @db.VarChar(255)
  description          String?          @db.Text
  departmentId         String?          @map("department_id") @db.Uuid
  teamId               String?          @map("team_id") @db.Uuid
  projectId            String?          @map("project_id") @db.Uuid
  priority             String           @default("MEDIUM") @db.VarChar(20)
  category             String           @default("GENERAL") @db.VarChar(50)
  startDate            DateTime?        @map("start_date") @db.Timestamptz
  dueDate              DateTime?        @map("due_date") @db.Timestamptz
  estimatedHours       Decimal?         @default(0) @map("estimated_hours") @db.Decimal(5, 2)
  actualHours          Decimal?         @default(0) @map("actual_hours") @db.Decimal(5, 2)
  status               String           @default("YET_TO_START") @db.VarChar(30)
  completionPercentage Int              @default(0) @map("completion_percentage")
  createdById          String           @map("created_by_id") @db.Uuid
  reviewedById         String?          @map("reviewed_by_id") @db.Uuid
  reviewFeedback       String?          @map("review_feedback") @db.Text
  reviewedAt           DateTime?        @map("reviewed_at") @db.Timestamptz
  completedAt          DateTime?        @map("completed_at") @db.Timestamptz
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?        @map("deleted_at") @db.Timestamptz

  department           Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team                 Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  project              Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator              User             @relation("TaskCreator", fields: [createdById], references: [id])
  reviewer             User?            @relation("TaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignments          TaskAssignment[]
  comments             TaskComment[]
  attachments          TaskAttachment[]
  dependencies         TaskDependency[] @relation("PrimaryTask")
  dependents           TaskDependency[] @relation("DependentTask")
  timeEntries          TaskTimeEntry[]
  workLogs             WorkLog[]
  timesheetEntries     TimesheetEntry[]

  @@map("tasks")
}

model TaskAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  assignedById String   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee     User     @relation("AssignedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("AssignedByUser", fields: [assignedById], references: [id])

  @@unique([taskId, employeeId])
  @@map("task_assignments")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.Text
  fileSize     Int?     @map("file_size")
  fileType     String?  @map("file_type") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader     User     @relation(fields: [uploadedById], references: [id])

  @@map("task_attachments")
}

model TaskDependency {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  task            Task     @relation("PrimaryTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("DependentTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

// =============================================================
// 6. HELPDESK & IT SERVICE TICKETS
// =============================================================

model TicketCategory {
  id            String              @id @default(uuid()) @db.Uuid
  name          String              @unique @db.VarChar(100)
  code          String              @unique @db.VarChar(50)
  description   String?             @db.Text
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  subcategories TicketSubcategory[]
  tickets       Ticket[]

  @@map("ticket_categories")
}

model TicketSubcategory {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @map("category_id") @db.Uuid
  name        String         @db.VarChar(100)
  code        String         @unique @db.VarChar(50)
  description String?        @db.Text
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  category    TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@map("ticket_subcategories")
}

model SlaPolicy {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique @db.VarChar(100)
  priority              String   @unique @db.VarChar(20)
  responseTargetMinutes Int      @map("response_target_minutes")
  resolveTargetMinutes  Int      @map("resolve_target_minutes")
  businessHoursOnly     Boolean  @default(true) @map("business_hours_only")
  description           String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  tickets               Ticket[]

  @@map("sla_policies")
}

model Ticket {
  id                      String            @id @default(uuid()) @db.Uuid
  referenceId             String            @unique @map("reference_id") @db.VarChar(20)
  ticketNumber            String            @unique @map("ticket_number") @db.VarChar(50)
  title                   String            @db.VarChar(255)
  description             String            @db.Text
  ticketType              String            @default("Incident") @map("ticket_type") @db.VarChar(50)
  categoryId              String?           @map("category_id") @db.Uuid
  subcategoryId           String?           @map("subcategory_id") @db.Uuid
  priority                String            @default("MEDIUM") @db.VarChar(20)
  priorityCode            String            @default("P3") @map("priority_code") @db.VarChar(10)
  impact                  String            @default("MEDIUM") @db.VarChar(20)
  urgency                 String            @default("MEDIUM") @db.VarChar(20)
  status                  String            @default("OPEN") @db.VarChar(30)
  requesterId             String            @map("requester_id") @db.Uuid
  assignedTechnicianId    String?           @map("assigned_technician_id") @db.Uuid
  assignedTeamId          String?           @map("assigned_team_id") @db.Uuid
  departmentId            String?           @map("department_id") @db.Uuid
  slaPolicyId             String?           @map("sla_policy_id") @db.Uuid
  source                  String            @default("PORTAL") @db.VarChar(30)
  resolutionSummary       String?           @map("resolution_summary") @db.Text
  rootCause               String?           @map("root_cause") @db.Text
  resolutionCategory      String?           @map("resolution_category") @db.VarChar(100)
  slaStatus               String            @default("WITHIN_SLA") @map("sla_status") @db.VarChar(30)
  slaPausedAt             DateTime?         @map("sla_paused_at") @db.Timestamptz
  slaPauseDurationSeconds Int               @default(0) @map("sla_pause_duration_seconds")
  firstResponseDueAt      DateTime?         @map("first_response_due_at") @db.Timestamptz
  resolutionDueAt         DateTime?         @map("resolution_due_at") @db.Timestamptz
  firstResponseAt         DateTime?         @map("first_response_at") @db.Timestamptz
  resolvedAt              DateTime?         @map("resolved_at") @db.Timestamptz
  closedAt                DateTime?         @map("closed_at") @db.Timestamptz
  reopenedAt              DateTime?         @map("reopened_at") @db.Timestamptz
  reopenCount             Int               @default(0) @map("reopen_count")
  escalatedAt             DateTime?         @map("escalated_at") @db.Timestamptz
  escalationReason        String?           @map("escalation_reason") @db.Text
  escalatedToRole         String?           @map("escalated_to_role") @db.VarChar(50)
  satisfactionRating      Int?              @map("satisfaction_rating")
  feedback                String?           @db.Text
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category                TicketCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory             TicketSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  requester               User              @relation("TicketRequester", fields: [requesterId], references: [id])
  assignedTechnician      User?             @relation("TicketTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  assignedTeam            Team?             @relation("TicketAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  department              Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  slaPolicy               SlaPolicy?        @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  comments                TicketComment[]
  history                 TicketHistory[]
  timeEntries             TicketTimeEntry[]
  workLogs                WorkLog[]
  timesheetEntries        TimesheetEntry[]

  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  comment    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ticket_comments")
}

model TicketHistory {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  changedBy String   @map("changed_by") @db.Uuid
  field     String   @db.VarChar(50)
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [changedBy], references: [id], onDelete: Cascade)

  @@map("ticket_history")
}

// =============================================================
// 7. WORK LOGS & TIME TRACKING
// =============================================================

model WorkLog {
  id                 String     @id @default(uuid()) @db.Uuid
  referenceId        String     @unique @map("reference_id") @db.VarChar(20)
  employeeId         String     @map("employee_id") @db.Uuid
  taskId             String?    @map("task_id") @db.Uuid
  ticketId           String?    @map("ticket_id") @db.Uuid
  logDate            DateTime   @map("log_date") @db.Date
  hoursSpent         Decimal    @map("hours_spent") @db.Decimal(5, 2)
  billingType        String     @default("REGULAR") @map("billing_type") @db.VarChar(30)
  workDescription    String     @map("work_description") @db.Text
  verifiedById       String?    @map("verified_by_id") @db.Uuid
  verificationStatus String     @default("PENDING") @map("verification_status") @db.VarChar(30)
  rejectionReason    String?    @map("rejection_reason") @db.Text
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

