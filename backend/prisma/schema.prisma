model PayrollBatch {
  id             String    @id @default(uuid()) @db.Uuid
  batchNumber    String    @unique @map("batch_number") @db.VarChar(30)
  month          Int
  year           Int
  totalDisbursed Decimal   @default(0) @map("total_disbursed") @db.Decimal(12, 2)
  employeeCount  Int       @default(0) @map("employee_count")
  status         String    @default("PROCESSED") @db.VarChar(30)
  processedById  String?   @map("processed_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  processedBy    User?     @relation("BatchProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  payslips       Payslip[]

  @@map("payroll_batches")
}

model Payslip {
  id                    String        @id @default(uuid()) @db.Uuid
  referenceId           String        @unique @map("reference_id") @db.VarChar(30)
  batchId               String?       @map("batch_id") @db.Uuid
  employeeId            String        @map("employee_id") @db.Uuid
  month                 Int
  year                  Int
  basicPay              Decimal       @default(0) @map("basic_pay") @db.Decimal(10, 2)
  hra                   Decimal       @default(0) @map("hra") @db.Decimal(10, 2)
  allowances            Decimal       @default(0) @map("allowances") @db.Decimal(10, 2)
  overtimePay           Decimal       @default(0) @map("overtime_pay") @db.Decimal(10, 2)
  grossEarnings         Decimal       @default(0) @map("gross_earnings") @db.Decimal(10, 2)
  taxDeduction          Decimal       @default(0) @map("tax_deduction") @db.Decimal(10, 2)
  pfDeduction           Decimal       @default(0) @map("pf_deduction") @db.Decimal(10, 2)
  insurance             Decimal       @default(0) @map("insurance") @db.Decimal(10, 2)
  unpaidLeaveDeductions Decimal       @default(0) @map("unpaid_leave_deductions") @db.Decimal(10, 2)
  totalDeductions       Decimal       @default(0) @map("total_deductions") @db.Decimal(10, 2)
  netSalary             Decimal       @default(0) @map("net_salary") @db.Decimal(10, 2)
  pdfUrl                String?       @map("pdf_url") @db.Text
  isEncrypted           Boolean       @default(true) @map("is_encrypted")
  status                String        @default("GENERATED") @db.VarChar(30)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz

  batch                 PayrollBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee              User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payslips")
}

