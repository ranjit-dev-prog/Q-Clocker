model Timesheet {
  id               String           @id @default(uuid()) @db.Uuid
  referenceId      String           @unique @map("reference_id") @db.VarChar(20)
  employeeId       String           @map("employee_id") @db.Uuid
  periodType       String           @default("WEEKLY") @map("period_type") @db.VarChar(20)
  startDate        DateTime         @map("start_date") @db.Date
  endDate          DateTime         @map("end_date") @db.Date
  totalHours       Decimal          @default(0) @map("total_hours") @db.Decimal(5, 2)
  billableHours    Decimal          @default(0) @map("billable_hours") @db.Decimal(5, 2)
  nonBillableHours Decimal          @default(0) @map("non_billable_hours") @db.Decimal(5, 2)
  status           String           @default("DRAFT") @db.VarChar(30)
